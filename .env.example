# Copy to .webull.env and fill locally.
WEBULL_APPLICATION_NAME=claw
WEBULL_APPLICATION_ID=975227233385213952
WEBULL_REGION=us

# Use sandbox until the account-list check succeeds and live mode is intentionally enabled.
WEBULL_ENV=sandbox

# Generated by Webull after pressing "Generate Key".
WEBULL_APP_KEY=
WEBULL_APP_SECRET=

# Safety switch. Leave 0 for read-only connection checks.
WEBULL_ALLOW_LIVE_TRADING=0

