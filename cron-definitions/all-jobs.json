        "timeoutSeconds": 3900
      },
      "delivery": {
        "mode": "none",
        "channel": "telegram",
        "to": "YOUR_TELEGRAM_CHAT_ID",
        "accountId": "YOUR_OPENCLAW_ACCOUNT_ID",
        "bestEffort": true
      }
    },
    {
      "name": "每日Claude开放书籍学习与系统成长",
      "role": "daily_book_learning_claude",
      "enabled_default": false,
      "schedule": {
        "kind": "cron",
        "expr": "0 3,6 * * *",
        "tz": "America/New_York",
        "description": "Daily at 03:00 and 06:00 ET (overnight research)"
      },
      "agentId": "us-market",
      "sessionTarget": "isolated",
      "wakeMode": "now",
      "payload": {
        "kind": "command",
        "argv": ["sh", "-lc", "python3 scripts/us_market_cron_runner.py --role daily_book_learning_claude"],
        "cwd": "/YOUR/WORKSPACE/PATH/workspace-us-market",
        "outputMaxBytes": 30000,
        "timeoutSeconds": 7800
      },
      "delivery": {
        "mode": "none"
      }
    },
    {
      "name": "美股盘中高流动性扫描 每小时33分 [OPTIONAL/DISABLED]",
      "role": "intraday_prediction_33",
