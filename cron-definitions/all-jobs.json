        "description": "First Sunday of the month at 11:00 ET"
      },
      "agentId": "us-market",
      "sessionTarget": "isolated",
      "wakeMode": "now",
      "payload": {
        "kind": "command",
        "argv": ["sh", "-lc", "python3 scripts/us_market_cron_runner.py --role monthly_prompt_eval_c"],
        "cwd": "/YOUR/WORKSPACE/PATH/workspace-us-market",
